# Smart Doctor–Patient Management System — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to Git

# MongoDB Atlas connection string
# Get this from: https://cloud.mongodb.com → Your Cluster → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/doctor-patient-db?retryWrites=true&w=majority

# JWT secret key — use a long random string (at least 32 characters)
JWT_SECRET=replace_this_with_a_long_random_secret_key_at_least_32_chars

# JWT token expiry
JWT_EXPIRES_IN=7d

# Server port
PORT=5000

# Node environment
NODE_ENV=development
